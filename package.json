{
  "name": "tallyard",
  "private": true,
  "version": "0.5.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/make-samples.mjs",
    "build": "vite build",
    "build:single": "node scripts/make-samples.mjs && vite build --mode single",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc -b",
    "lint": "oxlint",
    "test": "vitest run",
    "e2e": "npm run build && npm run build:single && node scripts/make-photo-fixture.mjs && playwright test",
    "shots": "node scripts/make-photo-fixture.mjs && playwright test --config playwright.shots.config.ts",
    "scan": "node scripts/scan.mjs",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build && npm run build:single && npm run scan"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "exceljs": "4.4.0",
    "papaparse": "5.7.0",
    "radix-ui": "1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "8.4.0",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.20.5",
    "@types/papaparse": "5.5.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "fake-indexeddb": "6.2.5",
    "jsdom": "30.1.2",
    "oxlint": "1.86.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.2",
    "vite-plugin-singlefile": "2.3.3",
    "vitest": "5.0.3"
  }
}
